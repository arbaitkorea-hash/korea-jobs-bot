// Схема JST ART (v2, мультиязычная).
//
// Ключевое решение: переводимые поля вынесены в отдельные таблицы *Translation
// с уникальным slug на каждый язык. Это даёт отдельные URL вида
// /ru/gallery/zakat-nad-ozerom и /en/gallery/sunset-over-the-lake, которые Google
// и Naver индексируют как самостоятельные страницы — ради этого весь проект и делается.
// Непереводимые данные (размеры, цена, статус, изображения) живут в основной таблице,
// чтобы не дублироваться между языками.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  RU
  EN
  KO
}

enum ArtworkStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum Technique {
  OIL
  ACRYLIC
  MIXED
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  PAID
  SHIPPED
  CANCELLED
}

enum OrderItemVariant {
  ORIGINAL
  PRINT
}

enum AdminRole {
  OWNER
  EDITOR
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                AdminRole @default(EDITOR)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Журнал подозрительной активности (п. 14 аудита безопасности).
model AuditLog {
  id        String   @id @default(cuid())
  event     String // LOGIN_FAILED | LOGIN_SUCCESS | LOGIN_LOCKED | RATE_LIMIT | SUSPICIOUS_ORDER | UPLOAD_REJECTED
  severity  String   @default("info") // info | warning | critical
  ipHash    String   @default("") // хеш IP, не сам IP — минимизация персональных данных
  actor     String   @default("") // email админа, если применимо
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([severity, createdAt])
}

model Collection {
  id       String @id @default(cuid())
  position Int    @default(0)

  ogImage String @default("")

  translations CollectionTranslation[]
  artworks     Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model CollectionTranslation {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale       Locale

  slug        String
  title       String
  description String @default("")

  seoTitle       String @default("")
  seoDescription String @default("")
  keywords       String @default("") // через запятую
  hashtags       String @default("") // через запятую
  canonicalUrl   String @default("")

  @@unique([collectionId, locale])
  @@unique([locale, slug])
}

model Artwork {
  id String @id @default(cuid())

  // Непереводимые характеристики работы
  year          Int?
  technique     Technique     @default(OIL)
  widthCm       Float
  heightCm      Float
  orientation   Orientation   @default(LANDSCAPE)
  dominantColor String        @default("") // HEX, для фильтра по цвету
  status        ArtworkStatus @default(AVAILABLE)

  priceOriginalCents Int
  pricePrintCents    Int?
  currency           String @default("KRW")

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  images       ArtworkImage[]
  translations ArtworkTranslation[]

  position    Int       @default(0)
  featured    Boolean   @default(false) // показывать на главной
  published   Boolean   @default(false)
  publishedAt DateTime?

  ogImage String @default("")

  views     Int @default(0)
  buyClicks Int @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
  @@index([collectionId])
  @@index([status])
  @@index([technique])
}

model ArtworkTranslation {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  locale    Locale

  slug        String
  title       String
  description String @default("")
  story       String @default("") // история/легенда картины

  seoTitle       String @default("")
  seoDescription String @default("")
  altText        String @default("")
  ogTitle        String @default("")
  ogDescription  String @default("")
  keywords       String @default("")
  hashtags       String @default("")
  canonicalUrl   String @default("")

  @@unique([artworkId, locale])
  @@unique([locale, slug])
}

model ArtworkImage {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  url       String
  format    String
  width     Int
  height    Int
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  createdAt DateTime @default(now())

  @@index([artworkId])
}

model BlogPost {
  id String @id @default(cuid())

  coverImage  String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?

  translations BlogPostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

model BlogPostTranslation {
  id         String   @id @default(cuid())
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  locale     Locale

  slug        String
  title       String
  excerpt     String @default("")
  contentHtml String @default("") // санитизируется DOMPurify при сохранении и при рендере

  seoTitle       String @default("")
  seoDescription String @default("")
  keywords       String @default("")
  hashtags       String @default("")
  canonicalUrl   String @default("")

  @@unique([blogPostId, locale])
  @@unique([locale, slug])
}

/// Ключевые слова и хэштеги уровня сайта, отдельно на каждый язык.
model SiteKeywords {
  locale    Locale   @id
  keywords  String   @default("")
  hashtags  String   @default("")
  updatedAt DateTime @updatedAt
}

/// Заказ. Персональные данные покупателя хранятся зашифрованными (AES-256-GCM,
/// см. src/lib/crypto.ts) — п. 13 аудита безопасности. Для поиска дублей и
/// антифрод-проверок рядом лежат необратимые хеши, а не открытые значения.
model Order {
  id String @id @default(cuid())

  customerNameEnc String
  emailEnc        String
  phoneEnc        String @default("")
  addressEnc      String @default("")
  messageEnc      String @default("")

  emailHash String @default("") // SHA-256, для антифрода и поиска повторов
  ipHash    String @default("") // SHA-256 от IP, сам IP не храним

  riskScore Int    @default(0)
  riskFlags String @default("") // через запятую: MANY_FROM_IP, DISPOSABLE_EMAIL, ...

  status     OrderStatus @default(NEW)
  totalCents Int
  currency   String      @default("KRW")
  locale     Locale      @default(RU)
  items      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([emailHash])
  @@index([ipHash, createdAt])
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artworkId      String?
  artwork        Artwork?         @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  titleSnapshot  String // название на момент заказа, сохраняется даже если картину удалят
  variant        OrderItemVariant
  quantity       Int              @default(1)
  unitPriceCents Int

  @@index([orderId])
}

model ContactMessage {
  id String @id @default(cuid())

  nameEnc    String
  emailEnc   String
  messageEnc String

  emailHash String @default("")
  ipHash    String @default("")
  locale    Locale @default(RU)

  createdAt DateTime @default(now())

  @@index([createdAt])
}
