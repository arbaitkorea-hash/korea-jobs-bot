# Скопируйте в .env и заполните реальными значениями.
# .env никогда не коммитится — см. .gitignore.

# ── Обязательные ────────────────────────────────────────────────────────────

# PostgreSQL. На Vercel берите строку в режиме pooled/transaction — serverless
# функции иначе быстро упираются в лимит подключений.
DATABASE_URL="postgresql://user:password@localhost:5432/jstart?schema=public"

# Подпись сессий NextAuth. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""

# Ключ шифрования персональных данных покупателей (имя, email, телефон, адрес).
# Сгенерировать: openssl rand -base64 32
#
# ВАЖНО: при смене ключа ранее сохранённые заказы и сообщения станут
# нечитаемыми — расшифровать их будет нечем. Храните его так же бережно,
# как саму базу, и не меняйте без необходимости.
ENCRYPTION_KEY=""

# Публичный адрес сайта без слэша на конце. Используется в metadata, sitemap,
# hreflang и JSON-LD — при неверном значении поисковик проиндексирует не те URL.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ── Необязательные ──────────────────────────────────────────────────────────

# Пароль первого администратора, которого создаст `npm run db:seed`.
# После первого входа переменную можно удалить.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Код подтверждения прав в Naver Search Advisor (searchadvisor.naver.com).
# Не секрет — публикуется в HTML. Без него мета-тег просто не выводится.
NEXT_PUBLIC_NAVER_VERIFICATION=""

# Хостнейм внешнего S3-совместимого хранилища медиа, если вы перевели загрузку
# картин туда (см. src/lib/storage.ts). Без него используется локальная папка
# storage/uploads — она годится только для разработки: на Vercel файловая
# система эфемерна и сбрасывается при каждом деплое.
# MEDIA_HOSTNAME="your-bucket.supabase.co"
