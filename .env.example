# Скопируйте в .env и заполните реальными значениями. .env никогда не коммитится (см. .gitignore).

# PostgreSQL — строка подключения (Supabase/Neon в проде, локальный Postgres для разработки)
DATABASE_URL="postgresql://user:password@localhost:5432/jstart?schema=public"

# NextAuth: секрет для подписи сессий/JWT. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""

# Публичный URL сайта (без слэша на конце) — используется в metadata, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Пароль администратора, который создаст prisma/seed.ts при первом запуске.
# Смена пароля из UI не реализована в MVP — при необходимости обновите
# passwordHash напрямую через `npx prisma studio` или повторный seed.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Опционально: хостнейм внешнего S3-совместимого хранилища медиа (см. src/lib/storage.ts).
# Если не задан — используется локальное хранилище storage/uploads (только для разработки,
# на Vercel файловая система эфемерна).
# MEDIA_HOSTNAME="your-bucket.supabase.co"
